RewriteEngine On

# CRITICAL: Prevent second-pass rewrites (fixes the loop issue)
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteRule ^ - [L]

# Force HTTPS (uncomment on production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Exclude existing files and directories from rewriting
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicitly exclude API, CSS, JS, assets
RewriteRule ^(api\.php|css/|js/|assets/|admin/) - [L]

# Pretty URLs: /category/slug → surah.php?slug=slug
RewriteRule ^category/([a-z0-9\-]+)/?$ surah.php?slug=$1 [L,QSA]

# Sitemap
RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]

# Remove .php extension (must be LAST)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Handle 404 errors - redirect to 404.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /404.php [L]

# Default fallback (Apache native 404 handler)
ErrorDocument 404 /404.php
